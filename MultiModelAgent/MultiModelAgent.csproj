<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);MEAI001;MAAI001;OPENAI001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.GenAI" Version="2.2.0" />
		<PackageReference Include="Microsoft.Agents.AI.Anthropic" Version="1.28.0" />
		<PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
	</ItemGroup>

</Project>
